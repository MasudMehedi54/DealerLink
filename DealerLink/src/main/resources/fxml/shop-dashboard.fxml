<?xml version="1.0" encoding="UTF-8"?>

<!--
  DealerLink - Shop Owner dashboard (mirrors ui/ShopDashboard.java).
  Place in: src/main/resources/fxml/shop-dashboard.fxml   (uses ../css/theme.css)

  Responsiveness (all PERCENT constraints, relative to the window):
    * Header GridPane columns: 55% title | 20% role chip | 25% logout (of window WIDTH)
    * Each tab's content is a GridPane; the table rows use percentHeight, so tables
      take a fixed share of the window HEIGHT (e.g. products table = 55%)
    * Form/search rows are GridPanes whose columns are percentWidth, so fields and
      buttons stretch or shrink with the window WIDTH
    * Tables use CONSTRAINED_RESIZE_POLICY: columns share the table width proportionally
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane fx:id="root" prefHeight="680.0" prefWidth="1000.0" style="-fx-background-color: #F1F5F9;"
            stylesheets="@../css/theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

   <!-- ===================== Header ===================== -->
   <top>
      <GridPane fx:id="header" hgap="14.0" styleClass="header-bar">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" percentWidth="55.0" />
            <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" percentWidth="20.0" />
            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" percentWidth="25.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints valignment="CENTER" />
         </rowConstraints>
         <children>
            <Label fx:id="welcome" styleClass="header-title" text="🏬  Welcome back, City Grocery Mart" GridPane.columnIndex="0" />
            <Label fx:id="roleChip" styleClass="header-role-chip" text="SHOP OWNER" GridPane.columnIndex="1" />
            <Button fx:id="logout" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.5);" styleClass="button-secondary" text="Logout" GridPane.columnIndex="2">
               <tooltip>
                  <Tooltip text="Sign out of DealerLink" />
               </tooltip>
            </Button>
         </children>
      </GridPane>
   </top>

   <!-- ===================== Tabs ===================== -->
   <center>
      <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE">
         <BorderPane.margin>
            <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
         </BorderPane.margin>
         <tabs>

            <!-- Tab 1: Search products and submit a request -->
            <Tab text="🔍  Search &amp; Request">
               <content>
                  <GridPane fx:id="searchTab" vgap="14.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints percentHeight="55.0" vgrow="ALWAYS" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                     </rowConstraints>
                     <children>
                        <Label styleClass="section-title" text="Browse Products" GridPane.rowIndex="0" />
                        <GridPane fx:id="searchBar" hgap="10.0" GridPane.rowIndex="1">
                           <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="85.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="15.0" />
                           </columnConstraints>
                           <children>
                              <TextField fx:id="searchField" maxWidth="1.7976931348623157E308" promptText="🔎  Search product name or category (e.g. rice, pharmacy)" GridPane.columnIndex="0" />
                              <Button fx:id="searchBtn" maxWidth="1.7976931348623157E308" styleClass="button-primary" text="Search" GridPane.columnIndex="1" />
                           </children>
                        </GridPane>
                        <TableView fx:id="table" styleClass="table-view" GridPane.rowIndex="2">
                           <columns>
                              <TableColumn fx:id="nameCol" prefWidth="300.0" text="Product" />
                              <TableColumn fx:id="catCol" prefWidth="200.0" text="Category" />
                              <TableColumn fx:id="unitCol" prefWidth="120.0" text="Unit" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <placeholder>
                              <Label text="No products found. Try a different search term." />
                           </placeholder>
                        </TableView>
                        <Separator GridPane.rowIndex="3" />
                        <Label styleClass="section-title" text="Request a Product" GridPane.rowIndex="4" />
                        <GridPane fx:id="requestBar" hgap="12.0" GridPane.rowIndex="5">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="16.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="18.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="36.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="30.0" />
                           </columnConstraints>
                           <children>
                              <Label text="Quantity needed:" GridPane.columnIndex="0" />
                              <Spinner fx:id="qtySpinner" editable="true" initialValue="10" max="100000" maxWidth="1.7976931348623157E308" min="1" GridPane.columnIndex="1" />
                              <Button fx:id="requestBtn" disable="true" maxWidth="1.7976931348623157E308" styleClass="button-primary" text="✅  Submit Request to Dealers" GridPane.columnIndex="2" />
                           </children>
                        </GridPane>
                        <Label fx:id="status" wrapText="true" GridPane.rowIndex="6" />
                     </children>
                  </GridPane>
               </content>
            </Tab>

            <!-- Tab 2: view own requests and compare dealer quotations -->
            <Tab text="📦  Requests &amp; Quotations">
               <content>
                  <GridPane fx:id="requestsTab" vgap="12.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints percentHeight="28.0" vgrow="ALWAYS" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints percentHeight="24.0" vgrow="ALWAYS" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                     </rowConstraints>
                     <children>
                        <Label styleClass="section-title" text="Your Requests" GridPane.rowIndex="0" />
                        <Button fx:id="refreshRequestsBtn" styleClass="button-secondary" text="🔄  Refresh" GridPane.rowIndex="1" />
                        <TableView fx:id="reqTable" styleClass="table-view" GridPane.rowIndex="2">
                           <columns>
                              <TableColumn fx:id="idCol" prefWidth="70.0" text="Req#" />
                              <TableColumn fx:id="prodCol" prefWidth="260.0" text="Product" />
                              <TableColumn fx:id="qtyCol" prefWidth="80.0" text="Qty" />
                              <TableColumn fx:id="statCol" prefWidth="120.0" text="Status" />
                              <TableColumn fx:id="quotesCol" prefWidth="140.0" text="Quotes Received" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <placeholder>
                              <Label text="You haven't submitted any requests yet." />
                           </placeholder>
                        </TableView>
                        <Separator GridPane.rowIndex="3" />
                        <Label styleClass="section-title" text="Dealer Quotations (cheapest highlighted)" GridPane.rowIndex="4" />
                        <TableView fx:id="quoteTable" styleClass="table-view" GridPane.rowIndex="5">
                           <columns>
                              <TableColumn fx:id="dealerCol" prefWidth="260.0" text="Dealer" />
                              <TableColumn fx:id="priceCol" prefWidth="140.0" text="Price" />
                              <TableColumn fx:id="daysCol" prefWidth="140.0" text="Delivery (days)" />
                              <TableColumn fx:id="qStatCol" prefWidth="120.0" text="Status" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <placeholder>
                              <Label text="Select a request above to see dealer quotations." />
                           </placeholder>
                        </TableView>
                        <GridPane fx:id="actionBar" hgap="12.0" GridPane.rowIndex="6">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="45.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="30.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                           </columnConstraints>
                           <children>
                              <Button fx:id="acceptBtn" maxWidth="1.7976931348623157E308" styleClass="button-primary" text="🏆  Accept Selected Quotation &amp; Place Order" GridPane.columnIndex="0" />
                              <Button fx:id="weatherBtn" maxWidth="1.7976931348623157E308" styleClass="button-secondary" text="☀️  Check Area Weather" GridPane.columnIndex="1" />
                           </children>
                        </GridPane>
                        <Label fx:id="weatherLabel" styleClass="hint-text" wrapText="true" GridPane.rowIndex="7" />
                        <Label fx:id="requestsStatus" wrapText="true" GridPane.rowIndex="8" />
                     </children>
                  </GridPane>
               </content>
            </Tab>

            <!-- Tab 3: orders and delivery tracking -->
            <Tab text="🚚  Orders &amp; Delivery">
               <content>
                  <GridPane fx:id="ordersTab" vgap="14.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints percentHeight="65.0" vgrow="ALWAYS" />
                        <RowConstraints vgrow="NEVER" />
                     </rowConstraints>
                     <children>
                        <Label styleClass="section-title" text="Your Orders" GridPane.rowIndex="0" />
                        <Button fx:id="refreshOrdersBtn" styleClass="button-secondary" text="🔄  Refresh" GridPane.rowIndex="1" />
                        <TableView fx:id="orderTable" styleClass="table-view" GridPane.rowIndex="2">
                           <columns>
                              <TableColumn fx:id="orderIdCol" prefWidth="80.0" text="Order#" />
                              <TableColumn fx:id="orderProdCol" prefWidth="240.0" text="Product" />
                              <TableColumn fx:id="orderDealerCol" prefWidth="220.0" text="Dealer" />
                              <TableColumn fx:id="orderPriceCol" prefWidth="130.0" text="Price" />
                              <TableColumn fx:id="orderStatusCol" prefWidth="130.0" text="Order Status" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <placeholder>
                              <Label text="You have no orders yet." />
                           </placeholder>
                        </TableView>
                        <Label fx:id="deliveryInfo" styleClass="hint-text" text="Select an order above to see its live delivery status." wrapText="true" GridPane.rowIndex="3" />
                     </children>
                  </GridPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>

   <!-- ===================== Notification bar ===================== -->
   <bottom>
      <Label fx:id="notificationBar" managed="false" maxWidth="1.7976931348623157E308" styleClass="notification-bar" visible="false">
         <BorderPane.margin>
            <Insets bottom="16.0" left="20.0" right="20.0" />
         </BorderPane.margin>
      </Label>
   </bottom>
</BorderPane>
